# Copy to the Apache sites configuration and replace the placeholders before enabling it.
# Keep the Laravel document root at public/; never point Apache at the repository root.

Define IDT_ROOT "/var/www/idt/current"
Define IDT_DOMAIN "example.com"

<VirtualHost *:80>
    ServerName ${IDT_DOMAIN}
    ServerAlias *.${IDT_DOMAIN}

    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>

<IfModule mod_ssl.c>
    <VirtualHost *:443>
        ServerName ${IDT_DOMAIN}
        ServerAlias *.${IDT_DOMAIN}
        DocumentRoot "${IDT_ROOT}/public"

        SSLEngine on
        SSLCertificateFile /etc/letsencrypt/live/example.com/fullchain.pem
        SSLCertificateKeyFile /etc/letsencrypt/live/example.com/privkey.pem

        <Directory "${IDT_ROOT}/public">
            AllowOverride All
            Options -Indexes
            Require all granted
        </Directory>

        # Private storage is outside DocumentRoot; keep this deny rule as defense in depth.
        <Directory "${IDT_ROOT}/storage/app/private">
            Require all denied
        </Directory>

        <FilesMatch "^\.">
            Require all denied
        </FilesMatch>

        <FilesMatch "\.(env|log|sql|sqlite|bak|ini|ya?ml)$">
            Require all denied
        </FilesMatch>

        LimitRequestBody 26214400
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

        <IfModule mod_expires.c>
            ExpiresActive On
            ExpiresByType text/css "access plus 7 days"
            ExpiresByType application/javascript "access plus 7 days"
            ExpiresByType image/svg+xml "access plus 7 days"
            ExpiresByType image/png "access plus 7 days"
            ExpiresByType image/jpeg "access plus 7 days"
        </IfModule>

        # For PHP-FPM deployments, configure the PHP handler for the host here.
        # WAMP/mod_php installations should use their existing PHP handler instead.
    </VirtualHost>
</IfModule>
