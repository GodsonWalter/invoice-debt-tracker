APP_NAME="Invoice and Debt Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://example.com
BASE_DOMAIN=example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
# Required only when running the demo seeders. Never commit the value.
SEED_USER_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Share authentication across the base domain and workspace subdomains.
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
CACHE_STORE=database
FILESYSTEM_DISK=local
REPORT_EXPORT_DISK=local
REPORT_EXPORT_RETENTION_DAYS=7

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
QUEUE_FAILED_DRIVER=database-uuids

REPORT_LARGE_EXPORT_ROW_THRESHOLD=5000

WORKSPACE_SELF_SERVICE_RESTORE_DAYS=30
WORKSPACE_PERMANENT_DELETION_DAYS=120
WORKSPACE_OWNER_RESTORE_WARNING_DAYS=7,1
WORKSPACE_PERMANENT_DELETION_WARNING_DAYS=30,7,1
WORKSPACE_LIFECYCLE_CLEANUP_BATCH_SIZE=100
WORKSPACE_LIFECYCLE_QUEUE_CONNECTION=database

# Use Redis only when it is provisioned and configured for this deployment.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=example.com
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Optional S3-compatible private storage. Leave unset when using local private storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Required only if the AI dashboard integration is enabled.
OPENAI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
